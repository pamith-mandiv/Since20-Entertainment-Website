# SINCE'20 Backend Configuration Settings (MERN Stack)
PORT=5001

# JWT Session security settings
JWT_SECRET=since20_super_secret_jwt_key_987654321

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/since20_db
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/since20_db?retryWrites=true&w=majority

# Spotify API credentials (Optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music developer keys (Optional)
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Email / Contact form SMTP credentials (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
