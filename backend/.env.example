# SINCE'20 Backend Configuration Settings Example
PORT=5001

# JWT Session security settings (Change this to a strong 32-character random string)
JWT_SECRET=your_jwt_secret_key_here

# MySQL Database configuration (Uncomment and adjust once MySQL is installed)
# DB_HOST=127.0.0.1
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=since20_db
# DB_PORT=3306

# Spotify API credentials (Optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music developer keys (Optional)
APPLE_TEAM_ID=
APPLE_KEY_ID=
